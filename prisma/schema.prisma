generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Auth.js Models ============

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  defaultCurrency String  @default("CNY")
  defaultShopType String  @default("MARKETPLACE")
  locale        String    @default("zh")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  products      Product[]
  subscriptions Subscription[]
  costTemplates CostTemplate[]
  auditLogs     AuditLog[]
  imageTranslateTasks ImageTranslateTask[]
  imageTranslateHighTasks ImageTranslateHighTask[]
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ MY Profit Models ============

model Product {
  id          String        @id @default(cuid())
  userId      String
  name        String        @db.VarChar(100)
  url         String?
  category    String        // TikTok category path
  shopType    ShopType      @default(MARKETPLACE)
  bxpStatus   BxpStatus     @default(NON_BXP)
  status      ProductStatus @default(PENDING)
  tags        String[]      @default([])
  note        String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skus Sku[]
}

enum ShopType {
  MARKETPLACE
  MALL
}

enum BxpStatus {
  BXP
  NON_BXP
  UNCERTAIN
}

enum ProductStatus {
  PENDING    // 待评估
  CANDIDATE  // 候选
  SAMPLING   // 打样
  ABANDONED  // 放弃
  LISTED     // 已上架
}

model Sku {
  id          String  @id @default(cuid())
  productId   String
  name        String? @db.VarChar(100)
  // 收入参数 (MYR)
  originalPrice   Decimal @db.Decimal(12, 4)
  sellerDiscount  Decimal @default(0) @db.Decimal(12, 4)
  platformDiscount Decimal @default(0) @db.Decimal(12, 4)
  buyerShipping   Decimal @default(0) @db.Decimal(12, 4)
  quantity        Int     @default(1)
  // 成本参数
  costCurrency    String  @default("CNY")
  purchasePrice   Decimal @default(0) @db.Decimal(12, 4)
  domesticShipping Decimal @default(0) @db.Decimal(12, 4)
  packagingCost   Decimal @default(0) @db.Decimal(12, 4)
  crossBorderLogistics Decimal @default(0) @db.Decimal(12, 4)
  localFulfillment Decimal @default(0) @db.Decimal(12, 4)
  storageCost     Decimal @default(0) @db.Decimal(12, 4)
  // 达人和广告
  affiliateRate   Decimal @default(0) @db.Decimal(5, 4) // 比例
  affiliateFixed  Decimal @default(0) @db.Decimal(12, 4)
  adRate          Decimal @default(0) @db.Decimal(5, 4)
  adFixed         Decimal @default(0) @db.Decimal(12, 4)
  // 其他
  otherCost       Decimal @default(0) @db.Decimal(12, 4)
  refundRate      Decimal @default(0) @db.Decimal(5, 4)
  refundRecovery  Decimal @default(0) @db.Decimal(12, 4)
  refundExtraCost Decimal @default(0) @db.Decimal(12, 4)
  // 汇率
  exchangeRate    Decimal @db.Decimal(10, 6) // CNY per MYR
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  calculations Calculation[]
}

model Calculation {
  id            String   @id @default(cuid())
  skuId         String
  // 完整输入快照 (JSON)
  inputSnapshot Json
  // 完整结果快照 (JSON)
  resultSnapshot Json
  // 关联版本
  feeRuleVersion String?
  exchangeRateValue Decimal @db.Decimal(10, 6)
  // 核心结果 (冗余存储便于查询)
  netProfit     Decimal  @db.Decimal(12, 4)
  netMargin     Decimal  @db.Decimal(5, 4)
  breakEvenPrice Decimal? @db.Decimal(12, 4)
  maxPurchasePrice Decimal? @db.Decimal(12, 4)
  createdAt     DateTime @default(now())

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model FeeRule {
  id            String   @id @default(cuid())
  site          String   @default("MY") // 国家站点
  feeType       FeeType
  category      String   // 类目路径
  shopType      ShopType
  bxpStatus     BxpStatus
  rate          Decimal? @db.Decimal(5, 4) // 比例费率
  fixedAmount   Decimal? @db.Decimal(12, 4) // 固定金额
  perUnit       FeeUnit  @default(ORDER)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  version       Int      @default(1)
  status        RuleStatus @default(DRAFT)
  source        String?  // 官方来源链接
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([site, feeType, category, shopType, bxpStatus, status])
  @@index([effectiveFrom, effectiveTo])
}

enum FeeType {
  COMMISSION      // 佣金
  TRANSACTION     // 交易费
  PLATFORM_SUPPORT // 平台支持费
}

enum FeeUnit {
  ORDER    // 按订单
  ITEM     // 按件
  REVENUE  // 按销售额比例
}

enum RuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ExchangeRate {
  id          String   @id @default(cuid())
  fromCurrency String
  toCurrency  String
  rate        Decimal  @db.Decimal(10, 6)
  source      String   @default("manual")
  isRealtime  Boolean  @default(false)
  fetchedAt   DateTime @default(now())

  @@index([fromCurrency, toCurrency, fetchedAt])
}

model CostTemplate {
  id          String @id @default(cuid())
  userId      String
  name        String @db.VarChar(100)
  params      Json   // 成本参数模板
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String           @id @default(cuid())
  userId      String
  plan        SubscriptionPlan @default(FREE)
  status      SubStatus        @default(ACTIVE)
  redeemCode  String?          @unique
  startsAt    DateTime         @default(now())
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

// ============ Image Translate Tool ============

model ImageTranslateTask {
  id          String   @id @default(cuid())
  userId      String
  status      String   @default("pending") // pending, processing, done, failed
  totalCount  Int      @default(0)
  doneCount   Int      @default(0)
  failedCount Int      @default(0)
  sourceDir   String   // OSS prefix for inputs
  outputDir   String   // OSS prefix for outputs
  report      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ImageTranslateItem[]

  @@index([userId, createdAt])
}

model ImageTranslateItem {
  id        String  @id @default(cuid())
  taskId    String
  fileName  String
  sourceKey String  // OSS key
  outputKey String? // OSS key
  status    String  @default("pending") // pending, processing, success, failed
  error     String?

  task ImageTranslateTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ============ Image Translate High-Concurrency Tool ============

model ImageTranslateHighTask {
  id          String   @id @default(cuid())
  userId      String
  status      String   @default("pending")
  totalCount  Int      @default(0)
  doneCount   Int      @default(0)
  failedCount Int      @default(0)
  sourceDir   String
  outputDir   String
  report      String?  @db.Text
  durationMs  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ImageTranslateHighItem[]

  @@index([userId, createdAt])
}

model ImageTranslateHighItem {
  id        String  @id @default(cuid())
  taskId    String
  fileName  String
  sourceKey String
  outputKey String?
  status    String  @default("pending")
  error     String?
  durationMs Int?
  cacheHit   Boolean @default(false)

  task ImageTranslateHighTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}
